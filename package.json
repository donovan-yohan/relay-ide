{
  "name": "claude-remote-cli",
  "version": "3.20.0",
  "description": "Remote web interface for Claude Code CLI sessions",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "claude-remote-cli": "dist/bin/claude-remote-cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc && vite build --config frontend/vite.config.ts",
    "build:server": "tsc",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "dev": "CLAUDE_REMOTE_CONFIG=./config.dev.json NO_PIN=1 CLAUDE_REMOTE_PORT=3457 node dist/server/index.js",
    "dev:vite": "vite --config frontend/vite.config.ts",
    "start": "tsc && vite build --config frontend/vite.config.ts && node dist/server/index.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-force-exit dist/test/*.test.js dist/test/**/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update": "playwright test --update-snapshots",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "remote",
    "cli",
    "terminal",
    "mobile",
    "web",
    "pty"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donovan-yohan/claude-remote-cli.git"
  },
  "license": "MIT",
  "author": "Donovan Yohan",
  "dependencies": {
    "@tanstack/react-query": "^5.96.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "diff2html": "^3.4.56",
    "eslint-plugin-sonarjs": "^4.0.2",
    "express": "^4.21.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shiki": "^4.0.2",
    "smee-client": "^5.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "playwright": "^1.58.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.1"
  }
}
