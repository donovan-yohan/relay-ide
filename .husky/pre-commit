#!/usr/bin/env sh
set -e

npx lint-staged
npm run check

# chalkbag hook — best-effort, skip silently if binary missing.
# Wrapped so a chalkbag failure doesn't mask the real lint/check exit codes
# above (set -e ensures those propagate first).
if command -v chalkbag >/dev/null 2>&1; then
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
  chalkbag internal hook-run "$repo_root" >/dev/null 2>&1 || true
fi