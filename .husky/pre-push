#!/usr/bin/env sh

# Detect worktree: --git-common-dir and --git-dir differ in worktrees
GIT_COMMON=$(git rev-parse --git-common-dir 2>/dev/null)
GIT_DIR_VAL=$(git rev-parse --git-dir 2>/dev/null)
IS_WORKTREE="no"
[ "$GIT_COMMON" != "$GIT_DIR_VAL" ] && IS_WORKTREE="yes"

# Compare against remote tracking branch (covers multi-commit pushes)
# Falls back to empty tree SHA for first push on a brand new repo
CHANGED_BASE=$(git rev-parse '@{push}' 2>/dev/null) \
  || CHANGED_BASE=$(git merge-base HEAD 'origin/nightly' 2>/dev/null) \
  || CHANGED_BASE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# Guard: skip vitest entirely if no test-related files changed
CHANGED_FILES=$(git diff --name-only "$CHANGED_BASE"...HEAD -- 'test/' 'server/' 'vitest.config.ts' 2>/dev/null)
if [ -z "$CHANGED_FILES" ]; then
  echo "relay-ide: no test-related files changed, skipping tests"
  exit 0
fi

if [ "$IS_WORKTREE" = "yes" ]; then
  # Worktree: run only changed tests, exclude env-sensitive
  # Single quotes required: prevents ! history expansion + preserves \[ for regex
  echo "relay-ide: worktree detected, running changed tests only"
  npx vitest run --changed "$CHANGED_BASE" --testNamePattern '^(?!.*\[needs:git-init\])'
else
  # Main tree: run changed tests only
  # Full suite runs in CI (npm test) and locally (npm test)
  npx vitest run --changed "$CHANGED_BASE"
fi
